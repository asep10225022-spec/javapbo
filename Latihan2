import java.util.Scanner;

public class modul2 {
    public static void main(String[] args) {

        // Keliling Lingkaran
        try (Scanner input = new Scanner(System.in)) {
            // Keliling Lingkaran
            System.out.print("Masukkan jari-jari lingkaran: ");
            double r = input.nextDouble();
            
            double keliling = 2 * Math.PI * r;
            
            // Luas Trapesium
            System.out.print("Masukkan sisi sejajar pertama: ");
            double a = input.nextDouble();
            
            System.out.print("Masukkan sisi sejajar kedua: ");
            double b = input.nextDouble();
            
            System.out.print("Masukkan tinggi trapesium: ");
            double t = input.nextDouble();
            
            double luasTrapesium = (a + b) * t / 2;
            
            // Luas Permukaan Prisma Segitiga
            System.out.print("Masukkan alas segitiga: ");
            double alas = input.nextDouble();
            
            System.out.print("Masukkan tinggi segitiga: ");
            double tinggiSegitiga = input.nextDouble();
            
            System.out.print("Masukkan sisi miring segitiga: ");
            double sisiMiring = input.nextDouble();
            
            System.out.print("Masukkan panjang prisma: ");
            double panjang = input.nextDouble();
            
            double luasAlas = alas * tinggiSegitiga / 2;
            double kelilingAlas = alas + tinggiSegitiga + sisiMiring;
            
            double luasPrisma =
                    2 * luasAlas + kelilingAlas * panjang;
            
            // Output
            System.out.println("\n=== HASIL PERHITUNGAN ===");
            System.out.println("Keliling Lingkaran = " + keliling);
            System.out.println("Luas Trapesium = " + luasTrapesium);
            System.out.println("Luas Prisma Segitiga = " + luasPrisma);
        }
    }
}

